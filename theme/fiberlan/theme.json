{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "96rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "navy",
          "name": "Granat",
          "color": "#0B132B"
        },
        {
          "slug": "blue",
          "name": "Błękit techniczny",
          "color": "#1D4ED8"
        },
        {
          "slug": "canvas",
          "name": "Tło jasne",
          "color": "#F4F6F9"
        },
        {
          "slug": "white",
          "name": "Biel",
          "color": "#FFFFFF"
        },
        {
          "slug": "line",
          "name": "Linia",
          "color": "#E2E8F0"
        },
        {
          "slug": "slate",
          "name": "Grafit",
          "color": "#1E293B"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Suisse Intl — nagłówki",
          "fontFamily": "'FIBERLAN Suisse Intl', 'Suisse Intl', 'Suisse Int’l', \"Suisse Int'l\", 'Manrope', Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Suisse Intl — tekst",
          "fontFamily": "'FIBERLAN Suisse Intl', 'Suisse Intl', 'Suisse Int’l', \"Suisse Int'l\", 'Manrope', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Manrope.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Opisy techniczne",
          "fontFamily": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Mały",
          "size": "0.875rem"
        },
        {
          "slug": "normal",
          "name": "Tekst",
          "size": "1rem"
        },
        {
          "slug": "lead",
          "name": "Wprowadzenie",
          "size": "clamp(1rem, 1.2vw, 1.2rem)"
        },
        {
          "slug": "subheading",
          "name": "Tytuł karty",
          "size": "clamp(1.08rem, 1.3vw, 1.4rem)"
        },
        {
          "slug": "section",
          "name": "Tytuł sekcji",
          "size": "clamp(1.65rem, 2.2vw, 2.6rem)"
        },
        {
          "slug": "hero",
          "name": "Tytuł główny",
          "size": "clamp(2.1rem, 3.8vw, 4.5rem)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "em"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "30",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "40",
          "name": "L",
          "size": "clamp(1.75rem, 1.25rem + 1.4vw, 2.75rem)"
        },
        {
          "slug": "50",
          "name": "XL",
          "size": "clamp(2.75rem, 2rem + 2.5vw, 5rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|navy"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "0",
        "right": "0"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|normal",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "600",
          "lineHeight": "1.12",
          "letterSpacing": "-0.025em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|hero"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|section"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|subheading",
          "fontWeight": "600",
          "lineHeight": "1.22"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "button": {
        "border": {
          "radius": "3px",
          "width": "1px",
          "style": "solid",
          "color": "transparent"
        },
        "color": {
          "background": "var:preset|color|blue",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "right": "1.25rem",
            "bottom": "0.8rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "1rem",
          "fontWeight": "600",
          "lineHeight": "1.3",
          "textDecoration": "none"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-fiberlan",
      "title": "FIBERLAN PL",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-en",
      "title": "FIBERLAN EN",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "project-pl",
      "title": "Fotorelacja FIBERLAN (PL)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "project-en",
      "title": "FIBERLAN project report (EN)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "project-body",
      "title": "Realizacja · tytuł i treść",
      "area": "uncategorized"
    },
    {
      "name": "header",
      "title": "Nagłówek",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Stopka",
      "area": "footer"
    },
    {
      "name": "header-en",
      "title": "Header (EN)",
      "area": "header"
    },
    {
      "name": "footer-en",
      "title": "Footer (EN)",
      "area": "footer"
    }
  ]
}
