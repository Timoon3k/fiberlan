{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "96rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "navy", "name": "Granat", "color": "#0B132B" },
        { "slug": "blue", "name": "Błękit techniczny", "color": "#1D4ED8" },
        { "slug": "canvas", "name": "Tło jasne", "color": "#F4F6F9" },
        { "slug": "white", "name": "Biel", "color": "#FFFFFF" },
        { "slug": "line", "name": "Linia", "color": "#E2E8F0" },
        { "slug": "slate", "name": "Grafit", "color": "#1E293B" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "display", "name": "Britannic Bold", "fontFamily": "'FIBERLAN Britannic', 'Britannic Bold', 'Arial Black', 'Arial', sans-serif" },
        { "slug": "body", "name": "Tekst", "fontFamily": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif" },
        { "slug": "mono", "name": "Opisy techniczne", "fontFamily": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Mały", "size": "0.875rem" },
        { "slug": "normal", "name": "Tekst", "size": "1rem" },
        { "slug": "lead", "name": "Wprowadzenie", "size": "clamp(1.0625rem, 0.92rem + 0.42vw, 1.375rem)" },
        { "slug": "subheading", "name": "Tytuł karty", "size": "clamp(1.375rem, 1.02rem + 0.72vw, 1.875rem)" },
        { "slug": "section", "name": "Tytuł sekcji", "size": "clamp(2rem, 1.36rem + 2.2vw, 3.875rem)" },
        { "slug": "hero", "name": "Tytuł główny", "size": "clamp(2.85rem, 1.86rem + 3.6vw, 6rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "em"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "1rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "clamp(1.75rem, 1.25rem + 1.4vw, 2.75rem)" },
        { "slug": "50", "name": "XL", "size": "clamp(2.75rem, 2rem + 2.5vw, 5rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|canvas", "text": "var:preset|color|navy" },
    "spacing": { "blockGap": "1.25rem", "padding": { "top": "0", "bottom": "0", "left": "0", "right": "0" } },
    "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|normal", "lineHeight": "1.55" },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "700", "lineHeight": "1.06", "letterSpacing": "-0.035em" }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|hero" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|section" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|subheading", "lineHeight": "1.15" } },
      "link": {
        "color": { "text": "inherit" },
        "typography": { "textDecoration": "underline" }
      },
      "button": {
        "border": { "radius": "3px", "width": "1px", "style": "solid", "color": "transparent" },
        "color": { "background": "var:preset|color|blue", "text": "var:preset|color|white" },
        "spacing": { "padding": { "top": "0.8rem", "right": "1.25rem", "bottom": "0.8rem", "left": "1.25rem" } },
        "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "1rem", "fontWeight": "600", "lineHeight": "1.3", "textDecoration": "none" }
      }
    }
  },
  "customTemplates": [
    { "name": "page-fiberlan", "title": "FIBERLAN PL", "postTypes": ["page"] },
    { "name": "page-en", "title": "FIBERLAN EN", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Nagłówek", "area": "header" },
    { "name": "footer", "title": "Stopka", "area": "footer" },
    { "name": "header-en", "title": "Header (EN)", "area": "header" },
    { "name": "footer-en", "title": "Footer (EN)", "area": "footer" }
  ]
}
